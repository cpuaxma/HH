{
  "name": "hpm-makeover-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Hot Pepper Media: The Bland Brand Makeover, a 30-second 1080x1920 Remotion reel",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render HpmMakeover out/hpm-makeover.mp4 --codec=h264 --crf=18",
    "stills": "node scripts/stills.mjs out/stills",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/arimo": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/tinos": "5.3.0",
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
