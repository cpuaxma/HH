{
  "name": "hpm-audit-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Hot Pepper Media: 3 Instagram fixes in 30 seconds, a 30-second 1080x1920 60fps Remotion reel",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render HpmAudit out/hpm-audit.mp4 --codec=h264 --crf=18",
    "stills": "node scripts/stills.mjs out/stills",
    "cues": "tsx scripts/sfx-cues.ts",
    "check": "tsx scripts/check-timeline.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/arimo": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/tinos": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/layout-utils": "4.0.537",
    "@remotion/motion-blur": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@remotion/three": "4.0.537",
    "lucide-react": "1.61.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
