{
  "name": "miran-gold-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Why Gold Rises When the Dollar Falls: a 1080x1920 Remotion reel in English and Arabic",
  "scripts": {
    "studio": "remotion studio",
    "dots": "node scripts/build-map-dots.mjs",
    "render:en": "remotion render GoldDollar out/gold-dollar-en.mp4 --props='{\"lang\":\"en\"}' --codec=h264 --crf=18",
    "render:ar": "remotion render GoldDollar out/gold-dollar-ar.mp4 --props='{\"lang\":\"ar\"}' --codec=h264 --crf=18",
    "render": "npm run render:en && npm run render:ar",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@remotion/cli": "4.0.537",
    "@remotion/motion-blur": "4.0.537",
    "@remotion/paths": "4.0.537",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "world-atlas": "2.0.2"
  }
}
