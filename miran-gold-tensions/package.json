{
  "name": "miran-gold-tensions",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render GoldTensionsAR out/gold-tensions-ar.mp4 --codec=h264 --crf=18",
    "still": "remotion still GoldTensionsAR",
    "typecheck": "tsc --noEmit",
    "export:phone": "ffmpeg -y -loglevel error -i out/gold-tensions-ar.mp4 -c:v libx264 -preset slow -crf 20 -maxrate 10M -bufsize 20M -profile:v high -level:v 4.2 -pix_fmt yuv420p -color_primaries bt709 -color_trc bt709 -colorspace bt709 -tag:v avc1 -c:a aac -b:a 192k -ar 48000 -movflags +faststart out/gold-tensions-ar-phone.mp4"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@remotion/cli": "^4.0.538",
    "@remotion/media": "^4.0.539",
    "@remotion/motion-blur": "^4.0.538",
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.538",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/react": "^18.3.12",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^5.6.3"
  }
}
