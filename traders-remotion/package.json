{
  "name": "traders-remotion",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render TradersArena out/traders.mp4 --codec=h264 --crf=16 --gl=swangle",
    "still": "remotion still TradersArena --gl=swangle",
