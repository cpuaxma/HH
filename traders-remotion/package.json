    "@remotion/google-fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/motion-blur": "4.0.539",
    "@remotion/three": "4.0.539",
    "postprocessing": "6.36.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@remotion/bundler": "^4.0.539",
    "@remotion/renderer": "4.0.539",
    "@types/react": "^18.3.12",
