{
  "name": "two-traders-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Two Traders, One Gold Market: a 1080x1920 Remotion reel in English and Arabic",
  "scripts": {
    "studio": "remotion studio",
    "sheets": "remotion still CharacterSheet out/sheet-ray.png --props='{\"who\":\"ray\"}' && remotion still CharacterSheet out/sheet-sam.png --props='{\"who\":\"sam\"}'",
    "stills": "node scripts/stills.mjs",
    "render:en": "remotion render TwoTraders out/two-traders-en.mp4 --props='{\"lang\":\"en\"}' --codec=h264 --crf=18",
    "render:ar": "remotion render TwoTraders out/two-traders-ar.mp4 --props='{\"lang\":\"ar\"}' --codec=h264 --crf=18",
    "render": "npm run render:en && npm run render:ar",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@remotion/cli": "4.0.537",
    "@remotion/motion-blur": "4.0.537",
    "@remotion/paths": "4.0.537",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
