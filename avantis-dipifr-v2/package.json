{
  "name": "avantis-dipifr-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Avantis: \"Four modules. One global qualification.\" 30s 1080x1920 DipIFR reel (Remotion + React Three Fiber)",
  "scripts": {
    "studio": "remotion studio",
    "stills": "node scripts/stills.mjs",
    "preview": "remotion render AvantisDipIFR out/preview.mp4 --scale=0.5 --crf=26 --x264-preset=veryfast --concurrency=1",
    "render": "remotion render AvantisDipIFR out/avantis-dipifr-reel.mp4 --concurrency=1 --crf=16 --x264-preset=slow --pixel-format=yuv420p --muted",
    "cover": "remotion still AvantisCover out/avantis-dipifr-cover.png",
    "check:camera": "tsx scripts/check-camera.ts",
    "check:video": "python3 scripts/scan-video.py out/avantis-dipifr-reel.mp4",
    "trace-logo": "python3 scripts/trace-logo.py assets/avantis-logo.jpg src/lib/logoTrace.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.4.0",
    "@react-three/postprocessing": "3.0.4",
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "@remotion/three": "4.0.537",
    "postprocessing": "6.37.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "tsx": "4.20.6"
  }
}